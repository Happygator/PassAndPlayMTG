{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Mirrors the `@platform` alias in vite.config.ts. tsc always type-checks
    // against the WEB channel; the other two are still checked as ordinary
    // files under `include`, just not as the alias target.
    "paths": {
      "@platform": ["./src/platform/web/index.ts"],
      "@platform/*": ["./src/platform/web/*"]
    }
  },
  "include": ["src"]
}
