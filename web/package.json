{
  "name": "three-card-blind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --mode app --port 5175 --strictPort",
    "dev:imessage": "vite --mode imessage --port 5176 --strictPort",
    "start": "node scripts/start.mjs",
    "generate": "npm run cube && npm run banlist && npm run catalogue && npm run lookup && npm run boosters",
  "prebuild": "npm run generate",
  "prebuild:app": "npm run generate",
  "prebuild:imessage": "npm run generate",
  "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode app",
    "build:imessage": "tsc --noEmit && vite build --mode imessage",
    "preview": "vite preview",
    "cube": "node scripts/build-cube.mjs",
    "banlist": "node scripts/build-banlist.mjs",
    "catalogue": "node scripts/build-catalogue.mjs",
    "lookup": "node scripts/build-lookup.mjs",
    "boosters": "node scripts/build-boosters.mjs",
    "boosters:sync": "node scripts/build-boosters.mjs --sync",
    "icons": "node scripts/make-icons.mjs",
    "sync:ios": "npm run build:app && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@preact/preset-vite": "^2.9.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
